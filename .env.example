# 阿里云 DashScope API Key (用于通义千问等模型)
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Xlinks GPT Image 2（PC/Cloud 文生图）与 Grok Imagine Video（异步视频）
XLINKS_API_KEY=your_xlinks_api_key_here
XLINKS_BASE_URL=https://api.xlinks.site/v1

# 阿里云 Access Key (用于 OSS、视频超分等服务)
ALIBABA_CLOUD_ACCESS_KEY_ID=your_aliyun_access_key_id_here
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your_aliyun_access_key_secret_here

# OSS 配置 (可选，用于图片/视频存储)
OSS_BUCKET_NAME=your_bucket_name
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_BASE_PATH=comic_gen/

# Kling AI 配置 (可选，用于 Kling 视频生成)
KLING_ACCESS_KEY=your_kling_access_key_here
KLING_SECRET_KEY=your_kling_secret_key_here

# Vidu AI 配置 (可选，用于 Vidu 视频生成)
VIDU_API_KEY=your_vidu_api_key_here

# 火山方舟 Seedance 2.0 配置 (推荐使用国内官方接口)
# Agent Plan 必须使用 Agent Plan 专属 API Key 和包含 /api/plan/ 的地址。
# Large 及以上 Agent Plan 套餐才包含视频生成额度。
# ARK_API_KEY=your_agent_plan_api_key_here
# SEEDANCE_PROVIDER_MODE=ark
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
# Agent Plan 模型名会自动使用 doubao-seedance-2.0；通常无需配置：
# ARK_SEEDANCE_MODEL=doubao-seedance-2.0
# 如果控制台为你的 Agent Plan 项目分配了其他模型或接入点 ID，必须填控制台显示的真实值。
# 普通方舟按量接口可改为：
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ARK_SEEDANCE_MODEL=doubao-seedance-2-0-260128

# MuleRun / MuleRouter 配置 (可选，用于 Seedance 2.0 视频生成 + GPT-Image-2 图片生成)
# 方式一 (推荐): 安装 MuleRun CLI 并登录，然后从 mulerun studio config 获取 key
#   npm i -g @mulerunai/cli && mulerun login
#   mulerun studio config  → 复制 API Key (格式: muk-...)
# 方式二: 直接用 MuleRouter API Key
# 两种 key 格式通用，填入同一变量即可：
# MULEROUTER_API_KEY=muk-your-key-here
# 站点选择 (mulerouter=默认, mulerun=更多模型但 gpt-image-2 仅 mulerouter 可用)
# MULEROUTER_SITE=mulerouter
# 如需让 Seedance 继续走 MuleRouter：
# SEEDANCE_PROVIDER_MODE=mulerouter

# LLM 多模型适配 (可选)
# 默认使用 DashScope (通过 OpenAI 兼容接口调用，只需上方 DASHSCOPE_API_KEY 即可)
# LLM_PROVIDER=dashscope
#
# 如需切换到第三方 OpenAI 兼容 API (OpenAI/DeepSeek/Ollama 等):
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o
#
# DeepSeek 示例:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_deepseek_api_key
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat
#
# 本地 Ollama 示例:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen2.5:72b

# API 服务配置
API_HOST=0.0.0.0
API_PORT=8000

# ===============================
# 部署模式
# desktop 为默认值，不依赖云端基础设施。
# cloud 模式必须完整配置以下 PostgreSQL、Redis、私有 OSS、会话密钥、
# 模型目录和服务端供应商凭据引用，否则后端拒绝启动。
# ===============================
LUMENX_DEPLOYMENT_MODE=desktop
# 前端静态构建模式；Docker 云端镜像会自动设为 cloud。
NEXT_PUBLIC_DEPLOYMENT_MODE=desktop
# 生产前端预构建镜像标签。发布机与服务器必须使用同一个值。
# LUMENX_FRONTEND_IMAGE=lumenx-frontend:20260901
# 应用必须使用非超级、无 BYPASSRLS 的专用角色，不能使用 POSTGRES_USER。
# LUMENX_DATABASE_URL=postgresql+psycopg://lumenx_app:change-me@postgres:5432/lumenx
# LUMENX_REDIS_URL=redis://redis:6379/0
# 非密钥的云实例、卷或运维库存稳定标识；不能只填 postgres/redis 服务别名。
# 正常启动可暂不填写，但真实 staging canary 会要求配置。
# LUMENX_DATABASE_RESOURCE_ID=rds-instance-or-volume-inventory-id
# LUMENX_REDIS_RESOURCE_ID=redis-instance-id
# LUMENX_OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
# LUMENX_OSS_BUCKET_NAME=lumenx-private
# LUMENX_OSS_ACCESS_KEY_ID=change-me
# LUMENX_OSS_ACCESS_KEY_SECRET=change-me
# LUMENX_OSS_PRIVATE=true
# LUMENX_SESSION_SECRET=replace-with-at-least-32-random-characters
# 首次启动会在迁移后幂等创建独立系统管理员，不会创建普通用户数据。
# 生产 Compose 从 secret 文件读取初始密码，不要把密码写入此文件。
LUMENX_BOOTSTRAP_ADMIN_USERNAME=admin
# LUMENX_BOOTSTRAP_ADMIN_PASSWORD=仅本地 override 使用
# 仅本地 docker-compose.override.yml 会启用；非本地部署必须保持 false。
LUMENX_ALLOW_DEFAULT_BOOTSTRAP_ADMIN_PASSWORD=false
# LUMENX_MODEL_CATALOG_PATH=config/model_catalog/generated/model_catalog.json
# LUMENX_LOCAL_TTS_MODEL=cosyvoice-v2
# 填写服务端可解析的环境变量名，多个名称用逗号分隔。
# LUMENX_PROVIDER_SECRET_REFS=DASHSCOPE_API_KEY,XLINKS_API_KEY
# LUMENX_LOCAL_XLINKS_API_KEY=replace-with-xlinks-api-key
# LUMENX_LOCAL_XLINKS_BASE_URL=https://api.xlinks.site/v1
# 本地 Docker 会把下列值映射给 worker，并强制使用火山 Seedance 2.0 视频路由。
# LUMENX_LOCAL_ARK_API_KEY=replace-with-ark-api-key
# LUMENX_LOCAL_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
# LUMENX_LOCAL_ARK_SEEDANCE_MODEL=doubao-seedance-2.0
# 非密钥的供应商账号/子账号稳定标识，必须与上述凭据实际归属一致。
# 正常启动可暂不填写，但真实 staging canary 会要求配置。
# LUMENX_PROVIDER_ACCOUNT_ID=dashscope-staging-subaccount
# 仅允许管理员从这个只读挂载目录选择本地迁移源。
# LUMENX_LOCAL_IMPORT_ROOT=/imports
# LUMENX_LOCAL_IMPORT_MAX_BYTES=10737418240
# LUMENX_GLOBAL_WORKER_CONCURRENCY=8
# LUMENX_PROVIDER_OUTPUT_ROOT=/provider-results
# 紧急熔断只能关闭入口，不能绕过数据库配置开启功能。
# 发布证据和灰度批准前保持 true；通过后由运维显式改为 false。
# 本地 Compose 默认开放无验证码手机号注册；紧急停用时改为 true
# LUMENX_REGISTRATION_EMERGENCY_DISABLED=false
# LUMENX_BOOTSTRAP_REGISTRATION_MODE=open
# LUMENX_NEW_AI_TASKS_EMERGENCY_DISABLED=true
# 可独立关闭扩展后台或仅关闭扩展后台写入操作；现有应急操作不受影响。
# LUMENX_ADMIN_CONSOLE_ENABLED=true
# LUMENX_ADMIN_CONSOLE_MUTATIONS_ENABLED=true
# 管理员限流按管理员和网络来源同时生效，三类操作使用独立额度。
# LUMENX_ADMIN_RATE_WINDOW_SECONDS=60
# LUMENX_ADMIN_MUTATION_LIMIT=120
# LUMENX_ADMIN_SENSITIVE_READ_LIMIT=60
# LUMENX_ADMIN_EXPORT_LIMIT=20
# LUMENX_ALLOWED_ORIGINS=https://studio.example.com
# LUMENX_AUTH_RATE_WINDOW_SECONDS=900
# LUMENX_AUTH_REGISTRATION_LIMIT=5
# LUMENX_AUTH_LOGIN_LIMIT=10
# LUMENX_AUTH_RESET_LIMIT=5
# Docker Compose 使用以下 secret 文件，不应提交真实内容：
# docker-compose-service.yml 的数据库 secret 路径（默认值已指向 secrets/，通常无需设置）
# LUMENX_DATABASE_ADMIN_PASSWORD_FILE=./secrets/postgres_password.txt
# LUMENX_DATABASE_APP_PASSWORD_FILE=./secrets/postgres_app_password.txt
# LUMENX_BOOTSTRAP_ADMIN_PASSWORD_FILE=./secrets/bootstrap_admin_password.txt
# LUMENX_SESSION_SECRET_FILE=./secrets/session_secret.txt
# LUMENX_OSS_ACCESS_KEY_ID_FILE=./secrets/oss_access_key_id.txt
# LUMENX_OSS_ACCESS_KEY_SECRET_FILE=./secrets/oss_access_key_secret.txt
# DASHSCOPE_API_KEY_FILE=./secrets/dashscope_api_key.txt
# XLINKS_API_KEY_FILE=./secrets/xlinks_api_key.txt

# 仅供 docker-compose.release.yml 的隔离发布测试栈使用。
# 正常 cloud/desktop 启动会拒绝以下确定性适配器配置。
# LUMENX_TEST_ADAPTERS_ENABLED=true
# LUMENX_OBJECT_STORE_ADAPTER=deterministic
# LUMENX_PROVIDER_ADAPTER=deterministic
# LUMENX_TEST_OBJECT_STORE_ROOT=/release-test-objects
# LUMENX_TEST_SIGNING_SECRET_FILE=./.release-secrets/release_test_signing_secret.txt

# ===============================
# API 端点配置 (可选，海外部署时切换到国际端点)
# 命名约定: {PROVIDER}_BASE_URL
# ===============================
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
# KLING_BASE_URL=https://api.klingai.com/v1
# VIDU_BASE_URL=https://api.vidu.cn/ent/v2
# MULEROUTER_BASE_URL=https://api.mulerouter.ai
