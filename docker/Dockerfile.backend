FROM python:3.11-slim

# Install FFmpeg, libass support, and a font with complete Simplified Chinese glyphs.
# Override DEBIAN_MIRROR at build time when deploying outside mainland China.
ARG DEBIAN_MIRROR=https://mirrors.aliyun.com
RUN set -eux; \
    for source in /etc/apt/sources.list /etc/apt/sources.list.d/debian.sources; do \
        if [ -f "$source" ]; then \
            sed -i \
                -e "s|https\\?://deb.debian.org|${DEBIAN_MIRROR}|g" \
                -e "s|https\\?://security.debian.org|${DEBIAN_MIRROR}/debian-security|g" \
                "$source"; \
        fi; \
    done; \
    apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    fontconfig \
    fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy and install Python dependencies (excluding pywebview)
COPY requirements-docker.txt requirements.txt
# Use the mainland mirror by default; override PIP_INDEX_URL for other regions.
ARG PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
RUN pip install --no-cache-dir \
    --index-url "${PIP_INDEX_URL}" \
    --timeout 120 \
    --retries 5 \
    -r requirements.txt

# Copy application code
COPY src/ src/
COPY migrations/ migrations/
COPY alembic.ini alembic.ini
COPY config/model_catalog/ config/model_catalog/
COPY scripts/ scripts/
COPY docker/cloud-entrypoint.sh /usr/local/bin/lumenx-cloud-entrypoint
RUN chmod +x /usr/local/bin/lumenx-cloud-entrypoint

# Create output directories
RUN mkdir -p output/uploads output/video output/assets output/storyboard \
    output/audio output/export output/video_inputs output/outputs/videos \
    output/provider-results /provider-results /imports

# Environment
ENV NO_PROXY="*.aliyuncs.com,localhost,127.0.0.1"
ENV no_proxy="*.aliyuncs.com,localhost,127.0.0.1"
ENV PYTHONUNBUFFERED=1

EXPOSE 17177

ENTRYPOINT ["/usr/local/bin/lumenx-cloud-entrypoint"]
CMD ["python", "-m", "uvicorn", "src.apps.comic_gen.api:app", "--host", "0.0.0.0", "--port", "17177", "--proxy-headers", "--forwarded-allow-ips=*"]
